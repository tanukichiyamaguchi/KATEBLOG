# WordPress Application Password 認証情報
# WordPress管理画面 → ユーザー → プロフィール → アプリケーションパスワード で生成
WP_URL=https://eyelash12.com
WP_USERNAME=kamata
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ===== OpenAI（ChatGPT）画像生成 =====
# 記事内容に応じたリアル写真風の画像を OpenAI Images API で生成する場合に設定。
# 未設定の場合は自動で sharp（グラデーション画像）にフォールバックする。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 画像モデル（既定: gpt-image-1。dall-e-3 も指定可）
OPENAI_IMAGE_MODEL=gpt-image-1
# 画像サイズ（空なら model に応じて自動。gpt-image-1: 1536x1024 / dall-e-3: 1792x1024）
OPENAI_IMAGE_SIZE=
# 画質（gpt-image-1: low|medium|high|auto、dall-e-3: standard|hd）
OPENAI_IMAGE_QUALITY=high
# 全画像共通で末尾に付与する追加スタイル指定（任意）
OPENAI_IMAGE_STYLE=

# 写真プロバイダの既定 openai | sharp | auto（既定: auto）
IMAGE_PROVIDER=auto

# ===== 図解・表紙の手書きフォント =====
# assets/fonts/ に同梱（Zen Kurenaido / Yomogi）。CIでは scripts/install-fonts.sh で登録。
DIAGRAM_FONT=Zen Kurenaido
